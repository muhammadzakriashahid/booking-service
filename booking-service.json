  "components": {
    "schemas": {
      "BookingResponseDto": {
        "required": [
          "id",
          "showtimeId",
          "customerEmail",
          "status",
          "totalPrice",
          "createdAtUtc",
          "seats"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "showtimeId": {
            "type": "string",
            "format": "uuid"
          },
          "customerEmail": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "totalPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CreateBookingRequestDto": {
        "required": [
          "showtimeId",
          "seats"
        ],
        "type": "object",
        "properties": {
          "showtimeId": {
            "type": "string",
            "format": "uuid"
          },
          "seats": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Bookings"
